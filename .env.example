# Copy to .env and fill in from Supabase Project Settings -> API.
# SUPABASE_ANON_KEY is safe to expose client-side; RLS in supabase/schema.sql is the real access boundary.
SUPABASE_URL=
SUPABASE_ANON_KEY=

# Service role key (Project Settings -> API -> service_role secret).
# NEVER expose this client-side -- it bypasses RLS entirely. Only read by
# api/*.ts serverless functions (delete-member, etc.), never by the Angular app.
SUPABASE_SERVICE_ROLE_KEY=

# Semaphore SMS (PH only) -- server-side only, used by api/send-sms.ts
SEMAPHORE_API_KEY=
SEMAPHORE_SENDER_NAME=

# Resend -- server-side only, used by api/reply-notify.ts (email on elder reply)
RESEND_API_KEY=
RESEND_FROM=

# Comma-separated emails auto-promoted to elder+approved on sign-up. Checked
# server-side against the verified auth session email, in api/check-auto-admin.ts.
AUTO_ADMIN=

# Fixed origin used for links in outbound emails (api/_lib/email.ts). Without
# this, the origin falls back to request headers, which a caller hitting the
# API directly could spoof to plant a phishing link in an otherwise-legitimate
# email. Set this in production; e.g. https://ccsgm-connect.vercel.app
APP_ORIGIN=
